# 复制本文件为 .env 后填写。任何一项都不要提交到公开仓库。
# ⚠️ LICENSE_SEED_HEX 等于印钞机私钥，泄露 = 任何人都能给自己签永久码。

# ── 企业微信（在 企业微信管理后台 → 我的企业 → 企业ID / 微信客服）──────────
WECOM_CORP_ID=          # 企业ID，形如 ww1234567890abcdef
WECOM_KF_SECRET=        # 微信客服 的 Secret（不是通讯录Secret）
WECOM_KF_ID=            # 客服账号ID，形如 wkxxxx（审批发码时要用到）
WECOM_TOKEN=            # 回调配置的 Token，3~32 位，自己起一个
WECOM_AES_KEY=          # 回调配置的 EncodingAESKey，43 位，后台随机生成

# ── 群机器人（推审批通知给你自己）─────────────────────────────────────────
# 企业微信群 → 右键添加群机器人 → 复制 Webhook 地址
GROUP_WEBHOOK_URL=

# ── 机器人自身安全 ────────────────────────────────────────────────────────
APPROVE_SECRET=         # 审批链接签名密钥，自己起一个长随机串
PUBLIC_BASE_URL=        # 机器人对外地址，如 https://bot.example.com（审批链接要用）

# ── 实时看板（SSE 推送）───────────────────────────────────────────────────
# 看板地址：PUBLIC_BASE_URL/dashboard
# 口令至少 16 位才会启用；不设置则看板与 /events 一律拒绝访问（安全默认）。
# 生成一个：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DASHBOARD_TOKEN=
# 心跳间隔（毫秒）。必须小于反向代理的空闲超时（Nginx 默认 60s），15s 最稳。
SSE_HEARTBEAT_MS=15000
# 断线重连时可回放的事件条数（环形缓冲）。手机网络频繁切换可调大到 500。
SSE_BUFFER_SIZE=200
# 同时允许的看板连接数，防止被恶意挂满。
SSE_MAX_CLIENTS=50
# cookie 是否强制 Secure：1 强制 / 0 关闭 / 留空则按 PUBLIC_BASE_URL 是否为 https 自动判断
COOKIE_SECURE=

# ── 发卡 ──────────────────────────────────────────────────────────────────
# 私钥内容：tools/license_private.key（64 位 hex）
LICENSE_SEED_HEX=
# 内嵌的 JustOneAPI Token，留空则客户需自己填 Token
JUSTONEAPI_TOKEN=
DEFAULT_PLAN=trial10    # trial10 / std30 / pro100

# ── 选填 ──────────────────────────────────────────────────────────────────
DOWNLOAD_URL=           # 下载页地址，自动回复客户"在哪下载"时用
ADMIN_CONTACT=          # 兜底联系方式，默认 微信：807108536
STORE_FILE=.data/orders.json
PORT=8787
