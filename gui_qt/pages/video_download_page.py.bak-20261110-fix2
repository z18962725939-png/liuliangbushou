def _fmt_duration(ms) -> str:
    """毫秒 → mm:ss / hh:mm:ss；无效值返回占位符。"""
    try:
        ms = int(ms or 0)
    except (TypeError, ValueError):
        ms = 0
    if ms <= 0:
        return "—"
    total = ms // 1000
    h, rem = divmod(total, 3600)
    m, s = divmod(rem, 60)
    return f"{h:02d}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"


