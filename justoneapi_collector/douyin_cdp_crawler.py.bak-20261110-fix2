class CDPCrawlError(Exception):
    """浏览器会话抓取失败（找不到浏览器 / 调试端口未就绪 / 页面异常等）。"""


class _PageSession:
    """一个 page target 的 CDP 会话。

    相比 browser_login 里的 CDPSession，这里多了**事件泵**：
    后台线程持续读取 WebSocket，把「命令响应」按 id 分发给 call()，
    把「事件」（Network.* / Page.*）缓冲进事件列表供拦截逻辑消费。
    """

    def __init__(self, ws: _WSClient, timeout: float = 30.0):
        self.ws = ws
        self.timeout = timeout
        self._id = 0
        self._lock = threading.Lock()
        self._responses: dict[int, dict] = {}
        self._events: list[dict] = []
        self._alive = True
        self._reader = threading.Thread(target=self._pump, daemon=True)
        self._reader.start()

    # -- 事件泵 -------------------------------------------------------
    def _pump(self):
        while self._alive:
            try:
                raw = self.ws.recv_text()
            except Exception:                  # noqa: BLE001
                return                          # 连接断开，线程自然退出
            try:
                msg = json.loads(raw)
            except Exception:                   # noqa: BLE001
                continue
            mid = msg.get("id")
            with self._lock:
                if mid is not None:
                    self._responses[int(mid)] = msg
                else:
                    self._events.append(msg)

    def drain_events(self) -> list[dict]:
        """取走并清空已缓冲的事件。"""
        with self._lock:
            ev = self._events
            self._events = []
            return ev

    # -- 调用 ---------------------------------------------------------
    def call(self, method: str, params: dict | None = None,
             timeout: float | None = None):
        with self._lock:
            self._id += 1
            mid = self._id
        self.ws.send_text(json.dumps(
            {"id": mid, "method": method, "params": params or {}},
            ensure_ascii=False,
        ))
        deadline = time.time() + (timeout or self.timeout)
        while time.time() < deadline:
            with self._lock:
                msg = self._responses.pop(mid, None)
            if msg is not None:
                if "error" in msg:
                    raise CDPCrawlError(f"{method} 失败：{msg['error']}")
                return msg.get("result") or {}
            time.sleep(0.05)
        raise CDPCrawlError(f"{method} 超时")

    def close(self):
        self._alive = False


class DouyinCDPCrawler:
    """驱动本机真实浏览器，拦截抖音页面自身的列表接口响应。"""

    def __init__(
        self,
        profile_dir: str | Path,
        headless: bool = False,
        timeout: float = 30.0,
    ):
        self.profile_dir = Path(profile_dir)
        self.headless = headless
        self.timeout = timeout
        self.port: int = 0
        self.proc: subprocess.Popen | None = None
        self._browser_session: CDPSession | None = None
        self._page: _PageSession | None = None
        self._page_ws: _WSClient | None = None
        self.browser_name = ""
        self.reused = False                     # True = 复用了已运行的浏览器实例
        self._pending: dict[str, str] = {}      # 待取 body 的响应 requestId -> url
        self._done: set[str] = set()            # 已取过 body 的 requestId
        # 最近一次列表响应里的 has_more：0＝真到底，1＝后面还有；None＝还没读到
        self._last_has_more: int | None = None
        # 拉取不完整时的说明（不是错误，数据仍然可用），空串＝完整
        self._partial_note = ""

    # ------------------------------------------------------------ 启动
    def start(self) -> tuple[bool, str]:
        """连上浏览器（优先复用已运行的实例），返回 (ok, msg)。

        为什么要复用：同一个 profile 目录只能被一个浏览器进程占用，
        用相同 --user-data-dir 再启动一次时，新进程会把命令交给已运行的
        实例后自己退出，导致新开的调试端口永远连不上（表现为"调试端口未就绪"）。
        所以这里把上次用的调试端口记在 profile 目录里，下次直接复用。
        """
        if self._try_reuse():
            return True, f"{self.browser_name} 已就绪（复用已打开窗口）"

        found = find_browser()
        if not found:
            return False, ("未找到本机浏览器：本功能需要 Microsoft Edge 或 Google Chrome，"
                           "请先安装其中任意一个")
        browser_path, self.browser_name = found

        self.profile_dir.mkdir(parents=True, exist_ok=True)
        self.port = free_port()

        args = [
            browser_path,
            f"--remote-debugging-port={self.port}",
            f"--user-data-dir={self.profile_dir}",
            "--no-first-run",
            "--no-default-browser-check",
            "--remote-allow-origins=*",
            # ★ 2026-10-24：开了调试端口后 navigator.webdriver 会变成 true，
            #   抖音据此判定"这是自动化"，作品播放器干脆不初始化（视频页
            #   里 <video> 一直不出 source，只剩引导素材）。这个开关把它压掉。
            "--disable-blink-features=AutomationControlled",
            "--disable-features=Translate,msEdgeSidebar,msIdentityFeatures",
            "--window-size=1280,900",
        ]
        if self.headless:
            args.append("--headless=new")
        args.append("https://www.douyin.com/")

        try:
            self.proc = subprocess.Popen(
                args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                close_fds=True,
            )
        except Exception as e:                  # noqa: BLE001
            return False, f"启动浏览器失败：{e}"

        sess = CDPSession(self.port, timeout=self.timeout)
        if not sess.wait_ready(timeout=30.0):
            return False, "浏览器已启动，但调试端口未就绪（可能被安全软件拦截）"
        try:
            sess.connect()
        except Exception as e:                  # noqa: BLE001
            return False, f"连接调试端口失败：{e}"
        self._browser_session = sess
        self._write_port()                      # 记下来，下次直接复用

        page_url = self._wait_page_url(timeout=30.0)
        if not page_url:
            return False, "未能打开页面（浏览器可能未正常加载）"
        try:
            self._attach_page(page_url)
        except Exception as e:                  # noqa: BLE001
            return False, f"连接页面失败：{e}"
        return True, f"{self.browser_name} 已就绪"

    # ------------------------------------------------------------ 内部
    @property
    def _port_file(self) -> Path:
        return self.profile_dir / ".cdp_port"

    def _try_reuse(self) -> bool:
        """尝试复用上一次启动的浏览器实例（调试端口记在 profile 目录里）。"""
        pf = self._port_file
        if not pf.exists():
            return False
        try:
            port = int(pf.read_text(encoding="utf-8").strip() or "0")
        except Exception:                       # noqa: BLE001
            return False
        if not port:
            return False
        probe = CDPSession(port, timeout=self.timeout)
        if not probe.wait_ready(timeout=3.0):
            return False
        try:
            probe.connect()
            ver = probe._http_json("/json/version")
        except Exception:                       # noqa: BLE001
            return False
        self._browser_session = probe
        self.port = port
        self.browser_name = str(ver.get("Browser") or self.browser_name or "浏览器")
        ws = self._wait_page_url(timeout=15.0)
        if not ws:
            return False
        try:
            self._attach_page(ws)
        except Exception:                       # noqa: BLE001
            return False
        self.reused = True
        return True

    def _write_port(self):
        try:
            self._port_file.write_text(str(self.port), encoding="utf-8")
        except Exception:                       # noqa: BLE001
            pass

    def _http_json(self, path: str):
        with urllib.request.urlopen(
                f"http://127.0.0.1:{self.port}{path}", timeout=5) as r:
            return json.loads(r.read().decode("utf-8", "replace"))

    def _wait_page_url(self, timeout: float = 30.0) -> str | None:
        deadline = time.time() + timeout
        while time.time() < deadline:
            try:
                for t in self._http_json("/json/list"):
                    if t.get("type") == "page" and t.get("webSocketDebuggerUrl"):
                        return t["webSocketDebuggerUrl"]
            except Exception:                   # noqa: BLE001
                pass
            time.sleep(0.5)
        return None

    def _attach_page(self, ws_url: str):
        ws = _WSClient(ws_url, timeout=self.timeout)
        ws.connect()
        self._page_ws = ws
        self._page = _PageSession(ws, timeout=self.timeout)
        try:
            self._page.call("Page.enable", {}, timeout=10)
        except Exception:                       # noqa: BLE001
            pass

    def _ensure_origin(self, url: str) -> bool:
        """把页面导航到指定抖音地址并等它真正加载完成。"""
        try:
            self._page.call("Page.navigate", {"url": url}, timeout=15)
        except Exception:                       # noqa: BLE001
            pass
        deadline = time.time() + 45.0
        expr = "JSON.stringify({h: location.href, s: document.readyState})"
        while time.time() < deadline:
            try:
                res = self._page.call("Runtime.evaluate", {
                    "expression": expr, "returnByValue": True,
                }, timeout=8)
                val = (res.get("result") or {}).get("value")
                info = json.loads(val) if val else {}
                if "douyin.com" in (info.get("h") or "") and \
                        info.get("s") in ("interactive", "complete"):
                    time.sleep(1.0)             # 缓一拍，等首屏请求发完
                    return True
            except Exception:                   # noqa: BLE001
                pass                            # 导航中上下文会重建，忽略后重试
            time.sleep(0.8)
        return False

    # ------------------------------------------------------------ 抓取
    def add_init_script(self, js: str) -> None:
        """在每个新文档里先跑一段 JS（CDP 的 addScriptToEvaluateOnNewDocument）。

        用于把自动化痕迹盖掉：带调试端口时 `navigator.webdriver` 为 true，
        抖音看到它就不初始化播放器。必须**在导航之前**注册才生效。
        """
        if self._page is None:
            return
        try:
            self._page.call("Page.addScriptToEvaluateOnNewDocument",
                            {"source": js}, timeout=10)
        except Exception:                       # noqa: BLE001
            pass

    def add_cookies(self, cookie_header: str,
                    domain: str = ".douyin.com") -> int:
        """把登录态 Cookie 注入当前浏览器，返回成功交给浏览器的条数。

        ★★★ 为什么这一步是「批量解析 92% 失败」的正解（2026-10-25 真机定因）
        ────────────────────────────────────────────────────────────────
        `douyin_page_resolver` 用的是**独立 profile**（为了不抢客户正在用的
        浏览器，避免把人家页面导航走），代价是**没有任何登录态**。
        而实测：未登录的浏览器访问 `https://www.douyin.com/video/<id>`，
        抖音会直接把它**重定向到 `https://www.douyin.com/jingxuan`（精选首页）**。
        页面标题是「抖音精选电脑版 - 抖音旗下优质视频平台」，
        页面上全是推荐位、没有播放器、也永远不会发 detail 请求。

        结果就是每条都要干等满 20 秒，最后报「页面渲染完成但没读到播放地址」，
        客户看到的却是「作品被删除 / 仅粉丝可见 / 换一份登录态」——
        跟真实原因完全无关。客户那批 182 条里失败 168 条，绝大部分是这个。

        注入 `config.json` 里的 `douyin_cookie` 之后，页面才会正常渲染作品页。

        ★ 为什么用 CDP 注入而不是复制 profile：同一个 user-data-dir 只能被
          一个浏览器进程占用，复制会连同锁文件一起复制，第二个进程起不来。
        """
        if not cookie_header or not cookie_header.strip():
            return 0
        if self._page is None:
            return 0

        items: list[dict] = []
        seen: set[str] = set()
        for part in cookie_header.split(";"):
            part = part.strip()
            if not part or "=" not in part:
                continue
            name, value = part.split("=", 1)
            name, value = name.strip(), value.strip()
            # 空名/重复名跳过：重复注入同名 Cookie，Chrome 只认最后一条，
            # 但多塞会让 setCookies 整批失败，不如先在本地去重
            if not name or name in seen:
                continue
            seen.add(name)
            items.append({
                "name": name,
                "value": value,
                "domain": domain,
                "path": "/",
                "secure": True,
                "httpOnly": False,
                # sameSite=None 必须搭配 secure=True，否则 Chrome 直接拒绝整条
                "sameSite": "None",
            })
        if not items:
            return 0
        try:
            try:
                self._page.call("Network.enable", {}, timeout=10)
            except Exception:                   # noqa: BLE001
                pass
            self._page.call("Network.setCookies", {"cookies": items}, timeout=15)
        except Exception:                       # noqa: BLE001
            return 0
        return len(items)

    def navigate(self, url: str) -> bool:
        """公开的导航入口（供单条作品解析复用，见 douyin_page_resolver）。

        抽出来是为了不让外部模块去碰 `_page` / `_ensure_origin` 这些私有成员：
        CDP 的会话重建细节（导航中上下文会失效、要重试）留在这里，外面只管调用。
        """
        if self._page is None:
            return False
        return self._ensure_origin(url)

    def evaluate(self, expression: str, timeout: float = 10.0):
        """在页面里跑一段 JS 并取回结果（returnByValue）。

        拿不到结果（上下文重建 / 页面正在跳转）时返回 None，不抛异常 ——
        调用方普遍在轮询里用它，异常只会把轮询搅乱。
        """
        if self._page is None:
            return None
        try:
            res = self._page.call("Runtime.evaluate", {
                "expression": expression, "returnByValue": True,
            }, timeout=timeout)
            return (res.get("result") or {}).get("value")
        except Exception:                       # noqa: BLE001
            return None

    def capture_aweme_detail(self, page_url: str,
                             timeout: float = 20.0) -> tuple[dict | None, str]:
        """打开作品页，截获页面**自己**发出的作品详情接口响应。

        ★ 为什么这条路比读 DOM 可靠（2026-10-24）：
          抖音新版页面不再把作品数据写进 SSR（`_ROUTER_DATA` 里 `video_layout`
          是 null），但它自己的 JS 仍然会带着合规签名去请求
          `/aweme/v1/web/aweme/detail/`。我们只截获响应、不碰签名算法 ——
          和 capture_list 抓列表是同一套机制，那条链路已经在线上跑着。

        返回 (aweme 字典, 失败原因)。aweme 结构与接口返回的 `aweme_detail` 一致。
        """
        if self._page is None:
            return None, "浏览器会话未启动"
        try:
            self._page.call("Network.enable", {"maxResourceBufferSize": 50_000_000,
                                               "maxPostDataSize": 1_000_000}, timeout=10)
        except Exception:                       # noqa: BLE001
            pass
        # 必须在导航之前清空：否则上一次解析残留的 requestId 会串到这一次
        self._pending.clear()
        self._done.clear()
        self._page.drain_events()

        # ★ 不用 _ensure_origin：那个要等 readyState 变成 complete（首屏图片、
        #   推荐流全加载完，常常 8~10 秒）。批量导入上百条时这一项就是几十分钟。
        #   这里发出导航后直接盯 detail 响应，拿到就走 —— 实测 3~5 秒。
        try:
            self._page.call("Page.navigate", {"url": page_url}, timeout=15)
        except Exception:                       # noqa: BLE001
            pass

        detail: dict | None = None
        deadline = time.time() + timeout
        # 失效链接要尽早认出来：抖音把短链跳回首页后，页面照样能加载，
        # 但永远不会发 detail 请求 —— 不提前判就是干等满 20 秒，
        # 批量导入几十条失效链接会让人以为软件卡死。
        # ★ 2026-10-25：`/jingxuan`（精选首页）必须一起算进去。抖音对
        #   **未登录**的浏览器就是把 /video/<id> 重定向到 /jingxuan，
        #   旧正则只覆盖 `douyin.com/` 和 `douyin.com/?x`，匹配不到它，
        #   于是每条都白等 20 秒（实测单条 55 秒里大半耗在这）。
        home_re = re.compile(r"^https?://(www\.)?douyin\.com/(jingxuan)?/?(\?.*)?$")
        next_hop_check = time.time() + 3.0
        while time.time() < deadline and detail is None:
            if detail is None and time.time() >= next_hop_check:
                next_hop_check = time.time() + 3.0
                href = str(self.evaluate("location.href") or "")
                if home_re.match(href):
                    # 话要说到点上：跳到首页 ≠ 链接失效。批量导入时客户照着
                    # 「请重新复制链接」去操作，重导一遍还是全红，只会更火。
                    return None, ("页面被抖音重定向到首页/精选页 —— "
                                  "浏览器没有有效登录态，请在「设置 → 平台登录」扫码后再试")

            for ev in self._page.drain_events():
                method = ev.get("method") or ""
                params = ev.get("params") or {}
                rid = params.get("requestId")

                if method == "Network.responseReceived":
                    url = str((params.get("response") or {}).get("url") or "")
                    if rid and any(p in url for p in _DETAIL_PATTERNS) \
                            and rid not in self._done:
                        self._pending[rid] = url
                    continue

                if method == "Network.loadingFinished":
                    url = self._pending.pop(rid, None)
                    if url is None:
                        continue
                    self._done.add(rid)
                    detail = self._parse_detail(self._get_body(rid, url))
                    if detail:
                        break
                    continue

                if method == "Network.loadingFailed":
                    self._pending.pop(rid, None)

            if detail is None:
                time.sleep(0.4)

        if detail:
            return detail, ""
        return None, "页面没有发出作品详情请求（可能被拦成验证码页，或作品已不存在）"

    @staticmethod
    def _parse_detail(body: str) -> dict | None:
        """从 detail 接口的响应体里取 aweme_detail。"""
        if not body:
            return None
        try:
            data = json.loads(body)
        except Exception:                       # noqa: BLE001
            return None
        if not isinstance(data, dict):
            return None
        d = data.get("aweme_detail")
        if isinstance(d, dict) and d.get("aweme_id"):
            return d
        return None

    def capture_list(
        self,
        kind: str,
        sec_uid: str,
        max_pages: int = 20,
        idle_rounds: int = 3,
        on_page: Any = None,
    ) -> tuple[list[dict], str]:
        """打开对应 Tab 并滚动页面，拦截列表接口响应。

        返回 (aweme_list 全量, error_msg)。中途即使出错也会返回已抓到的部分。
        """
        patterns = _LIST_PATTERNS.get(kind)
        if not patterns:
            return [], f"未知的列表类型：{kind}"
        if self._page is None:
            return [], "浏览器会话未启动"

        try:
            self._page.call("Network.enable", {"maxResourceBufferSize": 50_000_000,
                                               "maxPostDataSize": 1_000_000}, timeout=10)
        except Exception:                       # noqa: BLE001
            pass

        # 抖音的 Tab 入口在不同账号 / 不同版本下表现不一致（例如「收藏」只在
        # 本人页面出现，缺 enter_* 参数时会回退到作品 Tab），所以逐个候选地址试，
        # 哪个能抓到数据就用哪个。
        last_err = ""
        for url in self._url_candidates(kind, sec_uid):
            self._pending.clear()
            self._done.clear()
            self._partial_note = ""
            self._page.drain_events()

            if not self._ensure_origin(url):
                last_err = f"页面未能加载（{url}）"
                continue

            collected: list[dict] = []
            seen_aweme: set[str] = set()
            idle = 0
            self._last_has_more = None
            for _round in range(max_pages + idle_rounds):
                self._collect_events(patterns, collected, seen_aweme)
                if on_page and collected:
                    on_page(len(collected), collected)
                # 接口自己说 has_more=0 ⇒ 这个列表真的就这么长，别再空转
                if self._last_has_more == 0:
                    break
                # 滚动触发下一页（v1.24.4：滚真正的滚动容器，见 _JS_SCROLL）
                scrolled = self._scroll_down()
                before = len(collected)
                # 等新一页：最多 3.6 秒，一旦到货立刻进下一轮（原来死等 2.2 秒，
                # 慢网时容易误判成"没有新数据"，把自己判到底了）
                for _w in range(9):
                    time.sleep(0.4)
                    self._collect_events(patterns, collected, seen_aweme)
                    if len(collected) > before:
                        break
                if len(collected) == before:
                    idle += 1
                    # 已经贴底且连着两轮没有新数据 ⇒ 确实到底了，不必再空转
                    if idle >= idle_rounds or (scrolled.get("atEnd") and idle >= 2):
                        break
                else:
                    idle = 0

            if collected:
                if self._last_has_more == 1:
                    # 拉到了数据，但接口说后面还有 —— 多半是这一轮被限流了。
                    # 不能报错（报错会把已拉到的 50 多条全丢掉），只把事实记下来，
                    # 由上层决定怎么提示（见 list_user_list 的 partial_note）。
                    self._partial_note = (
                        f"只加载出 {len(collected)} 条，抖音那边显示还有更多没加载完"
                        "（多半是这一轮被限流）。过几分钟再点一次「拉取列表」，"
                        "通常就能补齐；已拉到的可以先下载。")
                return collected, ""
            cards = self._page_list_card_count()
            last_err = f"未抓到{_KIND_LABEL.get(kind, kind)}列表数据（{url}）"
            if cards == 0:
                # 页面连作品卡片都没渲染出来 ⇒ 不是"列表为空"，别让客户白折腾
                last_err += ("；页面这次也没渲染出作品卡片（抖音可能弹了验证码或"
                             "临时限流，过几分钟再试一次即可）")

        return [], (
            f"{last_err}。该列表可能为空、未公开，或浏览器里登录的账号不对；"
            f"可到「设置 → 抖音登录」重新扫码后再试。"
            if last_err else "抓取失败（未知原因）"
        )

    @staticmethod
    def _url_candidates(kind: str, sec_uid: str) -> list[str]:
        """按优先级给出待尝试的页面地址。"""
        tab = _TAB_OF_KIND.get(kind, "")
        home = "https://www.douyin.com/user/self"
        if kind == "collect":
            # 收藏是私密列表，实测只有「本人页 + 个人面板参数」才触发
            cands = [home + tab]
            if sec_uid:
                cands.append(f"https://www.douyin.com/user/{sec_uid}{tab}")
                cands.append(f"https://www.douyin.com/user/{sec_uid}"
                             "?showTab=favorite_collection")
            return cands
        cands = []
        if sec_uid:
            cands.append(f"https://www.douyin.com/user/{sec_uid}{tab}")
        if tab:                                 # 喜欢：本人页兜底
            cands.append(home + tab)
        elif not sec_uid:
            cands.append(home)
        return cands or [home]

    def get_own_sec_uid(self) -> tuple[str, str]:
        """取**当前浏览器登录账号**本人的 sec_uid。

        比 HTTP 版（调 profile/self 接口）更稳：只要浏览器里登着抖音就能拿到，
        不依赖 config.json 里那份可能已经过期的 Cookie。
        原理：访问 /user/self 会被重定向到 /user/<sec_uid>。
        """
        if self._page is None:
            return "", "浏览器会话未启动"
        if not self._ensure_origin("https://www.douyin.com/user/self"):
            return "", "页面未能加载（请在弹出的浏览器窗口里确认已登录抖音）"
        href = ""
        try:
            res = self._page.call("Runtime.evaluate", {
                "expression": "location.href", "returnByValue": True,
            }, timeout=10)
            href = str((res.get("result") or {}).get("value") or "")
        except Exception:                       # noqa: BLE001
            href = ""
        m = re.search(r"MS4wLj[A-Za-z0-9_\-]+", href)
        if m:
            return m.group(0), ""
        # 兜底：从页面里的主页链接找
        try:
            res = self._page.call("Runtime.evaluate", {
                "expression": (
                    "(() => {const a = document.querySelector('a[href*=\"MS4wLj\"]');"
                    " return a ? a.getAttribute('href') : '';})()"
                ), "returnByValue": True,
            }, timeout=10)
            href2 = str((res.get("result") or {}).get("value") or "")
        except Exception:                       # noqa: BLE001
            href2 = ""
        m2 = re.search(r"MS4wLj[A-Za-z0-9_\-]+", href2 or "")
        if m2:
            return m2.group(0), ""
        return "", "未能识别本人 sec_uid（请在弹出的浏览器窗口里确认已登录抖音）"

    # ★ v1.24.4：抖音主页**不在 document 上滚动**。
    #   实测（2026-10-24）：document.documentElement.scrollHeight 恒等于窗口高度
    #   （727 == 727），window.scrollY 永远是 0，`window.scrollTo(0, scrollHeight)`
    #   一点效果都没有 —— 真正的滚动条挂在内部容器上（本次实测是
    #   `div.parent-route-container.route-scroll-container`，sh=3091 ch=727）。
    #   后果：作品列表只拿到首屏预取的那几批（53 条），账号实际 68 条，
    #   而且因为「滚动后无新增 → idle+1」，6.6 秒后就被判成"到底了"，
    #   客户看到的就是"少了一截，软件也不报错"。
    #   所以这里改成：找**面积最大且真的能滚**的容器滚到底，window 只作兜底。
    _JS_SCROLL = r"""
    (() => {
      let best = null, bestArea = 0;
      for (const el of document.querySelectorAll('div,main,section')) {
        if (el.clientHeight < 200) continue;
        if (el.scrollHeight <= el.clientHeight + 50) continue;
        const cs = getComputedStyle(el);
        if (!/(auto|scroll)/.test(cs.overflowY)) continue;
        const area = el.clientWidth * el.clientHeight;
        if (area > bestArea) { bestArea = area; best = el; }
      }
      const out = (where, el) => JSON.stringify({
        where: where,
        atEnd: el.scrollTop + el.clientHeight >= el.scrollHeight - 80,
        st: Math.round(el.scrollTop), sh: el.scrollHeight, ch: el.clientHeight,
      });
      if (best) {
        best.scrollTop = best.scrollHeight;                 // 直接到底
        best.dispatchEvent(new Event('scroll', {bubbles: true}));
        return out('container', best);
      }
      const d = document.scrollingElement || document.documentElement;
      window.scrollTo(0, document.body.scrollHeight);
      return out('window', d);
    })()
    """

    def _scroll_down(self) -> dict:
        """把列表滚到底，返回 {where, atEnd, st, sh, ch}（拿不到时返回 {}）。"""
        if self._page is None:
            return {}
        try:
            res = self._page.call("Runtime.evaluate", {
                "expression": self._JS_SCROLL,
                "returnByValue": True,
            }, timeout=8)
            val = (res.get("result") or {}).get("value")
            return json.loads(val) if val else {}
        except Exception:                       # noqa: BLE001
            return {}

    def _page_list_card_count(self) -> int:
        """页面上已渲染的作品卡片数（用于判断页面是不是空壳/风控降级）。"""
        try:
            res = self._page.call("Runtime.evaluate", {
                "expression": (
                    "document.querySelectorAll("
                    "'[data-e2e=\"user-post-item\"], [data-e2e=\"user-post-list\"] li'"
                    ").length"
                ),
                "returnByValue": True,
            }, timeout=8)
            return int((res.get("result") or {}).get("value") or 0)
        except Exception:                       # noqa: BLE001
            return 0

    def _collect_events(
        self, patterns: tuple[str, ...],
        collected: list[dict], seen_aweme: set[str],
    ):
        """消费事件：认出列表响应 -> 等传输完成 -> 取响应体 -> 解析 aweme_list。"""
        for ev in self._page.drain_events():
            method = ev.get("method") or ""
            params = ev.get("params") or {}
            rid = params.get("requestId")

            if method == "Network.responseReceived":
                req_url = str((params.get("response") or {}).get("url") or "")
                if not any(p in req_url for p in patterns):
                    continue
                if any(x in req_url for x in _EXCLUDE_PATTERNS):
                    continue
                if rid and rid not in self._done and rid not in self._pending:
                    self._pending[rid] = req_url
                continue

            if method == "Network.loadingFinished":
                url = self._pending.pop(rid, None)
                if url is None:
                    continue
                self._done.add(rid)
                body = self._get_body(rid, url)
                if not body:
                    continue
                for a in self._parse_awemes(body):
                    aid = str(a.get("aweme_id") or "")
                    if aid and aid in seen_aweme:
                        continue
                    if aid:
                        seen_aweme.add(aid)
                    collected.append(a)
                continue

            if method == "Network.loadingFailed":
                self._pending.pop(rid, None)

    def _get_body(self, request_id: str, url: str) -> str:
        try:
            res = self._page.call("Network.getResponseBody",
                                  {"requestId": request_id}, timeout=15)
        except Exception:                       # noqa: BLE001
            return ""
        body = res.get("body") or ""
        if res.get("base64Encoded"):
            import base64
            try:
                body = base64.b64decode(body).decode("utf-8", "replace")
            except Exception:                   # noqa: BLE001
                return ""
        return body

    def _parse_awemes(self, body: str) -> list[dict]:
        """解析列表响应，同时把 `has_more` 记到 self._last_has_more。

        ★ has_more 是判断"到底了没有"的权威信号：0＝这个列表真的就这么长，
          1＝后面还有，只是还没滚出来。以前只取 aweme_list、把它丢了，
          于是「只拉到 53 条」和「账号只有 53 条」在代码里长得一模一样，
          客户看着少了一截，软件却认为已经拉完。
        """
        m = re.search(r"^\s*(\{.*\})\s*$", body, re.S)
        try:
            data = json.loads(m.group(1) if m else body)
        except Exception:                       # noqa: BLE001
            return []
        if not isinstance(data, dict):
            return []
        hm = data.get("has_more")
        if isinstance(hm, (int, bool)):
            self._last_has_more = 1 if hm else 0
        awemes = data.get("aweme_list")
        if not isinstance(awemes, list):
            return []
        return [a for a in awemes if isinstance(a, dict)]

    # ------------------------------------------------------------ 其它
    def get_cookie_header(self) -> str:
        """取当前浏览器的 douyin Cookie（可用于回写 config.json）。"""
        if self._browser_session is None:
            return ""
        try:
            cookies = self._browser_session.get_all_cookies()
        except Exception:                       # noqa: BLE001
            return ""
        return "; ".join(
            f"{c.get('name')}={c.get('value')}"
            for c in cookies if "douyin" in (c.get("domain") or "")
        )

    def open_url(self, url: str) -> None:
        if self._page is None:
            return
        try:
            self._page.call("Page.navigate", {"url": url}, timeout=15)
        except Exception:                       # noqa: BLE001
            pass

    def stop(self, kill_browser: bool = False):
        """关闭会话。默认不杀浏览器（用户可能还想浏览），仅断开连接。"""
        if self._page is not None:
            try:
                self._page.close()
            except Exception:                   # noqa: BLE001
                pass
            self._page = None
        if self._page_ws is not None:
            try:
                self._page_ws.close()
            except Exception:                   # noqa: BLE001
                pass
            self._page_ws = None
        if self._browser_session is not None:
            self._browser_session.close()
            self._browser_session = None
        if kill_browser:
            if self.proc is not None:
                try:
                    self.proc.terminate()
                except Exception:               # noqa: BLE001
                    pass
                self.proc = None
            elif self._browser_session is not None:
                try:                            # 复用来的实例：用 CDP 关掉
                    self._browser_session.call("Browser.close", {}, timeout=5)
                except Exception:               # noqa: BLE001
                    pass
            try:                                # 端口作废，下次重新拉起
                self._port_file.unlink()
            except Exception:                   # noqa: BLE001
                pass

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.stop()


def crawl_user_list(
    profile_dir: str | Path,
    kind: str,
    sec_uid: str,
    max_pages: int = 20,
    on_page: Any = None,
    headless: bool = False,
) -> tuple[list[dict], str]:
    """便捷入口：浏览器会话抓取某博主的作品 / 喜欢 / 收藏列表。

    返回 (aweme_list 全量, error_msg)。
    """
    crawler = DouyinCDPCrawler(profile_dir, headless=headless)
    ok, msg = crawler.start()
    if not ok:
        return [], msg
    try:
        return crawler.capture_list(kind, sec_uid, max_pages=max_pages,
                                    on_page=on_page)
    finally:
        crawler.stop()
