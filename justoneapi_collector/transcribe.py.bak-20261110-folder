def file_sha256(path: Path) -> str:
    """算文件 SHA256（1 MB 一块读，439 MB 大约 1 秒）。"""
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for blk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(blk)
    return h.hexdigest()


class _RangeIgnored(Exception):
    """镜像忽略了 Range 头 —— 分块写入会把已下好的块冲掉，必须退化为单线程。"""


