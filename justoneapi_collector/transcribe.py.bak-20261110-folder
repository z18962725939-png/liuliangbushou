def list_media_files(dirs: list[Path], exts: set[str] | None = None) -> list[Path]:
    """扫描目录里的音视频文件（不递归太深，避免把整个磁盘走一遍）。"""
    exts = exts or SUPPORTED_AUDIO_EXT
    out: list[Path] = []
    seen: set[str] = set()
    for d in dirs:
        try:
            if not d.exists():
                continue
        except Exception:                                  # noqa: BLE001
            continue
        try:
            for p in sorted(d.rglob("*")):
                if not p.is_file():
                    continue
                if p.suffix.lower() not in exts:
                    continue
                key = str(p).lower()
                if key in seen:
                    continue
                seen.add(key)
                out.append(p)
        except Exception:                                  # noqa: BLE001
            continue
    return out


def human_size(n: float) -> str:
    """把字节数说成人话。"""
    try:
        n = float(n)
    except Exception:                                      # noqa: BLE001
        return "-"
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit in ("B",) else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} GB"


def speed_hint(device: str, model: str) -> str:
    """给用户一个大致的速度预期，避免他不知道该等多久。"""
    gpu_fast = device == "cuda"
    table = {
        "tiny": (25, 60), "base": (15, 40), "small": (8, 20),
        "medium": (3, 8), "large-v3-turbo": (4, 10), "large-v3": (1.5, 4),
    }
    lo, hi = table.get(model, (5, 10))
    if not gpu_fast:
        lo, hi = max(0.3, lo * 0.08), max(0.8, hi * 0.1)
    unit = "倍速" if gpu_fast else "倍速（CPU 慢很多）"
    return f"预计 {lo:g}–{hi:g} {unit}：10 分钟音频约需 {max(1, round(10 / hi * 60))}–{max(1, round(10 / lo * 60))} 秒"
