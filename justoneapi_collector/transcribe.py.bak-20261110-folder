@dataclass
class TranscribeTask:
    src: Path
    model: str = DEFAULT_MODEL
    device: str = "cpu"            # 'cpu' | 'cuda'
    lang: str = "zh"               # 'zh' 中文，'auto' 自动
    out_dir: Path | None = None
    want_srt: bool = False
    translate: bool = False
    threads: int = 0               # CPU 线程数，0 = 自动


@dataclass
class TranscribeResult:
    ok: bool
    src: Path
    txt: Path | None = None
    srt: Path | None = None
    msg: str = ""
    seconds: float = 0.0


_PROGRESS_RE = re.compile(r"progress\s*=\s*(\d+)\s*%")


def _explain_rc(rc: int, device: str) -> str:
    """把 whisper-cli 的退出码翻译成人话。

    Windows 上进程"闪一下就没了"多半是加载器失败（缺 DLL / 位数不对），
    这类退出码是 0xC0000xxx，直接显示成 "-1073741515" 用户完全看不懂。
    """
    # 32 位有符号表示（subprocess 返回的就是这个）
    codes = {
        -1073741515: "缺少系统运行库（DLL 找不到）",
        -1073741511: "DLL 版本不匹配（入口点找不到）",
        -1073741701: "程序与系统位数不符（32/64 位混用）",
        -1073741819: "程序崩溃（访问冲突）",
    }
    why = codes.get(rc)
    if why is None and rc > 0x7FFFFFFF:
        why = codes.get(rc - 0x100000000)
    who = "显卡引擎" if device == "cuda" else "CPU 引擎"
    if why:
        return (
            f"{who}启动失败：{why}（退出码 {rc}）。\n"
            f"常见原因是显卡引擎的运行库不完整。点「检测显卡并一键安装」重新装一次；"
            f"如果还不行，先用 CPU 模式转写。"
        )
    return f"{who}退出码 {rc}，未产出文本"


class Transcriber:
    """把音视频转成 txt（可选 srt）。

    流程：ffmpeg 抽 16 kHz 单声道 wav → whisper-cli 转写 → 输出 txt/srt。
    每一步都能被 cancel() 打断，界面点「停止」不会卡住。
    """

    def __init__(self, ffmpeg: str | None = None, work_dir: Path | None = None):
        self.ffmpeg = ffmpeg
        self.work_dir = work_dir or (whisper_home() / "tmp")
        self._proc: subprocess.Popen | None = None
        self._cancel = threading.Event()

    def cancel(self):
        self._cancel.set()
        try:
            if self._proc and self._proc.poll() is None:
                self._proc.terminate()
        except Exception:                                  # noqa: BLE001
            pass

    # -- 1) 抽音频 --------------------------------------------------

    def extract_wav(self, src: Path, log=None) -> tuple[bool, Path | str]:
        if not self.ffmpeg:
            return False, "没有可用的 ffmpeg，无法抽取音频（可在设置里指定 ffmpeg.exe）"
        self.work_dir.mkdir(parents=True, exist_ok=True)
        wav = self.work_dir / (src.stem[:60] + ".wav")
        cmd = [
            self.ffmpeg, "-y", "-i", str(src),
            "-vn", "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le",
            str(wav),
        ]
        if log:
            log("抽取音频轨（16 kHz 单声道）…")
        try:
            proc = subprocess.run(
                cmd, capture_output=True, text=True, timeout=1800,
                encoding="utf-8", errors="replace",
                creationflags=subprocess.CREATE_NO_WINDOW if os.name == "nt" else 0,
            )
        except subprocess.TimeoutExpired:
            return False, "抽取音频超时（文件过大或 ffmpeg 卡住）"
        except Exception as e:                             # noqa: BLE001
            return False, f"抽取音频失败：{e}"

        if proc.returncode != 0 or not wav.exists():
            tail = ((proc.stderr or "")[-300:]).strip()
            return False, f"ffmpeg 抽音频失败：{tail or '未知原因'}"
        return True, wav

    # -- 2) 调 whisper-cli ------------------------------------------

    def run(self, task: TranscribeTask, progress=None, log=None) -> TranscribeResult:
        """执行转写。progress(percent 0-100)，log(一行文本)。"""
        t0 = time.time()
        src = Path(task.src)
        if not src.exists():
            return TranscribeResult(False, src, msg="源文件不存在")

        device = task.device

        # ★ v1.14.6：显卡档先做体检，而且必须在取 exe 之前。
        #   这是「找不到 cublas64_11.dll」那个系统错误框的正解 ——
        #   那个框是 Windows 加载器弹的，进程会卡在那儿等用户点「确定」，
        #   try/except 和 subprocess 超时都拦不住，只能在启动之前查文件。
        #   用不上显卡就不硬撑：CPU 引擎能用就改 CPU 继续跑，
        #   客户要的是文案，不是「必须用显卡跑」。
        degraded = ""
        if device == "cuda":
            why = engine_problem("cuda") if engine_exe("cuda") else "显卡(CUDA)引擎还没安装"
            if why:
                # 客户可能从没打开过「音视频转文本」页，CPU 引擎还没从安装包里
                # 释放出来。这里按需释放一次（随包自带约 2 MB，不联网），
                # 否则降级会因为没有 CPU 引擎而落空，退回到「引擎没装」。
                bootstrap_engine("cpu")
                cpu_exe = engine_exe("cpu")
                cpu_ok = cpu_exe is not None and not engine_problem("cpu")
                if not cpu_ok:
                    if engine_exe("cpu") is None:
                        return TranscribeResult(
                            False, src, msg="转写引擎还没安装，请先点「一键安装」")
                    return TranscribeResult(
                        False, src, msg="CPU 引擎也不完整，请先点「一键安装」重新安装")
                degraded = why
                if log:
                    log(why)
                    log("→ 已自动改用 CPU 引擎继续转写（结果完全一样，只是慢一些）")
                device, exe = "cpu", cpu_exe
            else:
                exe = engine_exe("cuda")
        else:
            if not engine_exe("cpu"):
                bootstrap_engine("cpu")          # 同上：按需释放随包自带的 CPU 引擎
            exe = engine_exe(device)
            if not exe:
                return TranscribeResult(
                    False, src, msg="CPU 引擎还没安装，请先点「一键安装」")

        mpath = model_path(task.model)
        if not mpath.exists():
            return TranscribeResult(False, src, msg=f"模型 {task.model} 还没下载")

        out_dir = Path(task.out_dir) if task.out_dir else src.parent
        out_dir.mkdir(parents=True, exist_ok=True)
        prefix = out_dir / src.stem

        # 音频 → wav
        ok, wav = self.extract_wav(src, log=log)
        if not ok:
            return TranscribeResult(False, src, msg=str(wav))
        wav = Path(wav)                                    # type: ignore[arg-type]

        cmd = [
            str(exe),
            "-m", str(mpath),
            "-f", str(wav),
            "-l", task.lang or "auto",
            "-of", str(prefix),
            "-pp",
            "-otxt",
        ]
        if task.want_srt:
            cmd.append("-osrt")
        if task.translate:
            cmd.append("-tr")
        if device == "cpu":
            n = task.threads or max(1, (os.cpu_count() or 4))
            cmd += ["-t", str(n)]

        if log:
            if device == "cuda":
                log("开始转写…（显卡模式首次运行要初始化 CUDA，约需十几秒）")
            else:
                log("开始转写…（CPU 模式）")

        try:
            self._proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, encoding="utf-8", errors="replace",
                creationflags=subprocess.CREATE_NO_WINDOW if os.name == "nt" else 0,
            )
        except Exception as e:                             # noqa: BLE001
            return TranscribeResult(False, src, msg=f"启动 whisper-cli 失败：{e}")

        # 逐行实时读输出：一边解析进度一边避免管道缓冲区塞满（读就不会堵）
        try:
            for line in self._proc.stdout or []:           # type: ignore[union-attr]
                if self._cancel.is_set():
                    break
                line = line.rstrip()
                if not line:
                    continue
                m = _PROGRESS_RE.search(line)
                if m and progress:
                    try:
                        progress(int(m.group(1)))
                    except Exception:                      # noqa: BLE001
                        pass
                elif log and len(line) < 200:
                    log(line)
            self._proc.wait(timeout=7200)
            rc = self._proc.returncode
        except subprocess.TimeoutExpired:
            self.cancel()
            return TranscribeResult(False, src, msg="转写超时（超过 2 小时）已中止")
        finally:
            try:
                if self._proc and self._proc.stdout:
                    self._proc.stdout.close()
            except Exception:                              # noqa: BLE001
                pass
            self._proc = None

        # 清掉临时 wav，别让 1 小时的录音占着几个 G
        try:
            if wav.exists():
                wav.unlink()
        except Exception:                                  # noqa: BLE001
            pass

        if self._cancel.is_set():
            return TranscribeResult(False, src, msg="已取消")

        txt = prefix.with_suffix(".txt")
        srt = prefix.with_suffix(".srt")
        if rc != 0 and not txt.exists():
            return TranscribeResult(False, src, msg=_explain_rc(rc, device))
        if not txt.exists():
            return TranscribeResult(False, src, msg="转写结束但没有生成 txt 文件")

        return TranscribeResult(
            ok=True, src=src, txt=txt,
            srt=srt if (task.want_srt and srt.exists()) else None,
            msg=("完成（显卡引擎不可用，本次用 CPU 转写）" if degraded else "完成"),
            seconds=round(time.time() - t0, 1),
        )


