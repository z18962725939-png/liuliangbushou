    return models_dir() / info["file"]


def engine_exe(kind: str) -> Path | None:
    """返回可用引擎的 whisper-cli.exe 路径；没装返回 None。"""
    d = engine_dir(kind)
    for name in ("whisper-cli.exe", "main.exe", "whisper-cli", "main"):
        p = d / "Release" / name
        if p.exists():
            return p
        p2 = d / name
        if p2.exists():
            return p2
    return None


def _has_file(d: Path, name: str) -> bool:
    return (d / "Release" / name).exists() or (d / name).exists()


def engine_missing_files(kind: str) -> list[str]:
    """引擎目录里缺哪些必备文件。

    为什么需要它：whisper-cli.exe 是动态链接 whisper.dll 的。以前只判断
    "whisper-cli.exe 在不在"，结果某个版本打包漏了 whisper.dll，界面上
    显示"引擎就绪"，用户一点转写就报一句看不懂的错。现在把 DLL 一起查了，
    缺了就直接告诉用户"引擎不完整，请重新下载"。

    ★ v1.14.6：显卡档还要查 CUDA 运行库。这是客户报的那条
      「由于找不到 cublas64_11.dll，无法继续执行代码」的根因 ——
      11.8 包不带 cuBLAS，exe 在，但一启动就被 Windows 加载器拦下。
      这种错误弹的是**系统消息框**，不会变成 Python 异常，只能靠事前查文件拦住。
    """
    d = engine_dir(kind)
    if os.name != "nt":
        return []
    miss: list[str] = []
    if not _has_file(d, "whisper.dll"):
        miss.append("whisper.dll")

    if kind != "cuda":
        return miss

    # 显卡档：ggml-cuda.dll 是真正的 GPU 后端。缺了它不会报错，
    # 而是**静默退回 CPU**（用户会以为"显卡模式怎么这么慢"），所以必须查。
    if not _has_file(d, "ggml-cuda.dll"):
        miss.append("ggml-cuda.dll")

    # 该要 11 还是 12 那一套运行库：优先按目录里已有的 cudart 判断；
    # 全新空目录按 12（现在的默认包）判断。
    ver = "12"
    if _has_file(d, "cudart64_110.dll") and not _has_file(d, "cudart64_12.dll"):
        ver = "11"
    for name in _CUDA_RUNTIME[ver]:
        if not _has_file(d, name):
            miss.append(name)
    return miss


def engine_problem(kind: str) -> str:
    """引擎不能用的原因，说人话；能用返回空串。

    给界面和转写入口共用：界面显示它，转写前拿它判断要不要降级。
    """
    miss = engine_missing_files(kind)
    if not miss:
        return ""
    if kind != "cuda":
        return f"CPU 引擎不完整（缺 {', '.join(miss)}），点「检测显卡并一键安装」重新装一次即可"

    low = [m.lower() for m in miss]
    if any("cublas" in m for m in low):
        if any("cublas64_11" in m for m in low):
            return (
                "显卡引擎缺 CUDA 运行库（缺 " + "、".join(miss) + "）。\n"
                "旧版 CUDA 11.8 引擎包不含这些库，需要本机安装 CUDA Toolkit 11.8 才能跑。\n"
                "解决办法：点「检测显卡并一键安装」，改下自带的 12.4 完整包（439 MB，"
                "运行库已内置，装完即用）。"
            )
        return (
            "显卡引擎缺 CUDA 运行库（缺 " + "、".join(miss) + "）。\n"
            "点「检测显卡并一键安装」重新下载一次即可（439 MB，运行库已内置）。"
        )
    if any("ggml-cuda" in m for m in low):
        return (
            "显卡引擎缺少 GPU 后端（ggml-cuda.dll），现在其实会退回 CPU 跑。\n"
            "点「检测显卡并一键安装」重新下载显卡引擎。"
        )
    return f"显卡引擎不完整（缺 {', '.join(miss)}），点「检测显卡并一键安装」重新下载"


def engine_ready(kind: str) -> bool:
    exe = engine_exe(kind)
    if exe is None:
        return False
    # exe 在但 DLL 不全 → 当没装，交给上层触发重新下载
    return not engine_missing_files(kind)


def model_ready(key: str) -> bool:
    p = model_path(key)
    if not p.exists():
        return False
    # 下载中断会留下半个文件，用体积粗校验一下（达不到 90% 就当没下完）
    try:
        want = (MODELS.get(key) or {}).get("size_mb", 0) * 1024 * 1024
        return p.stat().st_size >= want * 0.9 if want else p.stat().st_size > 0
    except Exception:                                      # noqa: BLE001
        return False


def status_text(kind: str, model_key: str) -> str:
    """给界面用的一句话状态。"""
    ok_e = engine_ready(kind)
    ok_m = model_ready(model_key)
    who = "显卡(CUDA)" if kind == "cuda" else "CPU"
    if ok_e:
        e = "已就绪"
    elif engine_exe(kind) is not None:
        # exe 在但库不全：要说清"不完整"，不能显示"未安装"——
        # 用户看到"未安装"会去点安装，看到"不完整"才知道是补文件
        miss = engine_missing_files(kind)
        e = f"不完整（缺 {len(miss)} 个运行库：{', '.join(miss[:2])}…）" if len(miss) > 2 \
            else f"不完整（缺 {', '.join(miss)}）"
    else:
        e = "未安装"
    m = "已就绪" if ok_m else "未下载"
    return f"引擎[{who}]：{e}　模型[{model_key}]：{m}"


# ----------------------------------------------------------------------
#  分块并发下载器
# ----------------------------------------------------------------------

class Downloader:
    """多线程分块下载。

    为什么必须分块：实测单线程从国内镜像拉 whisper.cpp 的包只有约 105 KB/s，
    一个 465 MB 的模型要 70 多分钟；8 线程分块可以稳定到 1.4 MB/s，
    同样的模型 5 分钟出头。差别是"能用"和"不能用"。

    失败策略：单块失败重试 2 次，整条 URL 失败则切下一个镜像源。
    """

    # 每块 2 MB。★ v1.14.6 从 4 MB 调小：实测 439 MB 的包在慢镜像上总有
    # 一两个 4 MB 块反复拿不全（连接被掐在 3.x MB 处），而同样位置 8 MB
    # 的 curl 分段却能完整拿到 —— 说明单连接能跑多久很不稳定，
    # 块小一点就少一个"必须一口气跑完 4 MB"的硬要求。
    # 代价是连接数翻倍，摊到 8 线程里几乎看不出差别。
    BLOCK = 2 * 1024 * 1024

    def __init__(self, threads: int = 8, timeout: float = 20.0,
                 stall_timeout: float = 60.0, probe_timeout: float = 6.0):
        self.threads = max(1, int(threads))
        self.timeout = timeout
        # 一个「块」都没完成的时间超过这个值，就认定这个源挂住了，直接换源。
        # ★ v1.28.2：以前看的是累计字节，某个块被掐断重试时字节来回变，
        #   计时器被反复刷新，这个保护等于没有 —— 客户对着 89% 干等十几分钟。
        self.stall_timeout = stall_timeout
        # HEAD / Range 探测用短超时：实测 ghfast.top、mirror.ghproxy.com 已经
        # 完全不响应，20 秒一个个白等过去，光探测就要一分钟以上。
        self.probe_timeout = probe_timeout
        self._cancel = threading.Event()
        self._stalled = False
        self._lock = threading.Lock()
        # 本次下载已完成的块序号 —— **进度的唯一真相**。换源续传靠它。
        self._done_blocks: set[int] = set()
        # 正在下载、还没完成的块：{块号: 本次已写入字节}。用「覆盖」而非
        # 「累加」，重试时自动从新值算，不会再出现重复计数。
        self._inflight: dict[int, int] = {}
        # 已上报过的最大进度。换源时未完成的块作废，允许小幅回落，但绝不
        # 让客户看到进度条往回跳（整包退化时由 whole() 主动清零）。
        self._peak = 0
        # 最后一次上报的字节数（诊断/兼容用，不再是累加器）
        self._done = 0
        self._total = 0
        # 停滞计时：**跨轮保持**。以前在 _pump 里每轮从零开始，
        # 而某块反复失败时每轮都会重开 _pump —— 计时器被无限重置，
        # 客户看到的就是「日志一直刷预计剩余时间，进度永远 89%」。
        self._stall_last_t = 0.0
        self._stall_last_blocks = -1
        self._stall_count = 0

    def cancel(self):
        self._cancel.set()

    @property
    def cancelled(self) -> bool:
        return self._cancel.is_set()

    def _progress_bytes(self, total: int) -> int:
        """权威进度 = 已完成块的完整字节 + 进行中块已写入字节。

        ★ v1.28.2：老实现用 `_done += len(chunk)` 累加，某块被镜像掐断重试时
          会把半块字节再加一遍 —— 进度虚高；换源按 `_done_blocks` 重算又掉回
          真实值，客户看到的就是 90%→88%→91%→89% 来回震荡。
          现在 `_done_blocks` 是唯一真相，重算只会算出同一个值。
        """
        done = sum(min(self.BLOCK, max(0, total - i * self.BLOCK))
                   for i in self._done_blocks if i >= 0)
        # 已完成块不再计入进行中，避免 add(i) 前后重复计数
        done += sum(v for k, v in self._inflight.items()
                    if k >= 0 and k not in self._done_blocks)
        # 整包退化（不支持 Range）时用虚拟块 -1 记账
        done += self._inflight.get(-1, 0)
        return min(max(done, 0), total)

    # -- 单源尝试 ---------------------------------------------------

    def _head(self, url: str) -> int:
        """拿文件总大小；拿不到返回 0。"""
        try:
            req = urllib.request.Request(url, method="HEAD")
            with urllib.request.urlopen(req, timeout=self.probe_timeout) as r:
                return int(r.headers.get("Content-Length") or 0)
        except Exception:                                  # noqa: BLE001
            return 0

    def _supports_range(self, url: str) -> bool:
        """探测服务端是否支持断点续传。

        有些镜像（以及测试用的简易服务器）会直接忽略 Range 头返回 200 全量，
        这时如果还按分块去 seek 写，会把同一个文件重复写进不同位置，
        结果是文件变大且内容全错 —— 必须先问一句再决定用不用分块。
        """
        try:
            req = urllib.request.Request(url, headers={"Range": "bytes=0-0"})
            with urllib.request.urlopen(req, timeout=self.probe_timeout) as r:
                code = getattr(r, "status", None) or r.getcode()
                return code == 206 or bool(r.headers.get("Content-Range"))
        except Exception:                                  # noqa: BLE001
            return False

    def _fetch_range(self, url: str, start: int, end: int, dest, offset: int,
                     retries: int = 2, block_idx: int | None = None) -> bool:
        """下载 [start, end] 这一段并写入已打开文件的 offset 处。

        ★ 必须校验响应是不是真的 206：
          有的镜像"礼貌地忽略" Range 头，直接回 200 + 整个文件。那时
          `r.read()` 会把 439 MB 全倒进这个 4 MB 的槽位，从 offset 一路
          覆盖到文件尾 —— 结果是体积正确、内容全坏。以前只看写没写完，
          所以这种坏文件会被当成下载成功。
        """
        want = end - start + 1
        for attempt in range(retries + 1):
            if self._cancel.is_set():
                return False
            # ★ 每次重试先把本块进度归零。老实现是 `_done += len(chunk)`
            #   一路累加，断线重试时半块字节被算了两次 —— 进度虚高。
            if block_idx is not None:
                with self._lock:
                    self._inflight[block_idx] = 0
            try:
                req = urllib.request.Request(url, headers={"Range": f"bytes={start}-{end}"})
                with urllib.request.urlopen(req, timeout=self.timeout) as r:
                    if start > 0:
                        code = getattr(r, "status", None) or r.getcode()
                        crange = (r.headers.get("Content-Range") or "").strip()
                        if code != 206 or not crange.startswith(f"bytes {start}-"):
                            raise _RangeIgnored(
                                f"镜像返回 {code} / Content-Range={crange!r}")
                    pos = offset
                    while True:
                        if self._cancel.is_set():
                            return False
                        chunk = r.read(65536)
                        # 读完再查一次：取消/换源可能就发生在这次阻塞读期间，
                        # 不查的话已经作废的字节还会被写进 .part 污染续传数据。
                        if self._cancel.is_set():
                            return False
                        if not chunk:
                            break
                        with self._lock:
                            dest.seek(pos)
                            dest.write(chunk)
                        pos += len(chunk)
                        if block_idx is not None:
                            with self._lock:
                                # 覆盖式赋值：重试只反映「本次」写到哪儿
                                self._inflight[block_idx] = pos - offset
                # ★ 写完不等于写全：镜像可能在传输中提前掐断（连接被限速/重置），
                #   `r.read()` 正常返回 EOF，循环break，函数"成功"返回，
                #   可这个块其实只写了一半 —— 文件体积仍是预分配的满额，
                #   于是得到一个体积正确、内容有洞的坏包。
                #   必须核对这次到底写了多少字节。
                got = pos - offset
                if got != want:
                    if attempt >= retries:
                        return False
                    time.sleep(0.4 * (attempt + 1))
                    continue
                return True
            except _RangeIgnored:
                raise
            except Exception:                              # noqa: BLE001
                if attempt >= retries:
                    return False
                time.sleep(0.6 * (attempt + 1))
        return False

    # -- 主入口 ------------------------------------------------------

    def download(self, urls: list[str], dest: Path, total_hint: int = 0,
                 progress=None, expect_sha256: str = "") -> tuple[bool, str]:
        """依次尝试 urls，成功返回 (True, '')，全失败返回 (False, 原因)。

        progress 回调签名：progress(done_bytes, total_bytes)。

        expect_sha256 非空时，下完要校验；不匹配**不报错退出**，而是删掉
        重新换下一个源下 —— 传坏数据的往往只是某一个镜像，换源通常就对了。
        """
        dest.parent.mkdir(parents=True, exist_ok=True)
        tmp = dest.with_suffix(dest.suffix + ".part")
        last_err = ""
        self._done_blocks = set()
        self._inflight.clear()
        self._peak = 0
        self._done = 0
        self._stall_last_t = 0.0
        self._stall_last_blocks = -1
        self._stall_count = 0
        resumed = False
        total = total_hint      # 所有源都探测失败时也可能用到

        for url in urls:
            if self._cancel.is_set() and not self._stalled:
                break
            self._cancel.clear()
            self._stalled = False
            # 换一个源就给一次新机会，但同一源内的多轮重试共享同一个计时
            self._stall_last_t = time.time()
            self._stall_last_blocks = -1
            total = self._head(url) or total_hint
            if total <= 0:
                last_err = "拿不到文件大小，可能被镜像拦截"
                continue
            # 只在本次会话第一次进下载时恢复；换源时不能重复加载
            if not resumed:
                resumed = True
                if self._load_blocks(tmp, total):
                    self._peak = self._progress_bytes(total)
                    self._done = self._peak

            ok = self._try_one(url, tmp, total, progress)
            self._save_blocks(tmp, total)
            if self._stalled:
                # 这个源卡住不动了：换下一个源，但**不删 .part** ——
                # 已经下好的块留在盘上，下一个源只补缺的（块级续传）。
                last_err = "下载长时间没有进展，已自动切换备用源"
                self._cancel.clear()
                self._stalled = False
                continue
            if self._cancel.is_set():
                # ★ 主动停止时保留已下的块：下次点安装从 89% 接着下，
                #   不是从 0 重来（439 MB 在慢镜像上重来一次就是十几分钟）。
                return False, "已取消"
            if ok and expect_sha256:
                try:
                    got = file_sha256(tmp)
                except Exception as e:                     # noqa: BLE001
                    got = f"<算不出来：{e}>"
                if got.lower() != expect_sha256.lower():
                    # 内容坏了，已下的块不可信，清掉重来
                    last_err = ("下载回来的文件校验不通过（大小对、内容坏），"
                                "已自动换源重试")
                    self._cleanup(tmp)
                    self._drop_blocks(tmp)
                    self._done_blocks = set()
                    self._inflight.clear()
                    self._peak = 0
                    continue
            if ok:
                try:
                    if tmp.exists():
                        if dest.exists():
                            dest.unlink()
                        tmp.replace(dest)
                    self._drop_blocks(tmp)
                    self._done = total
                    return True, ""
                except Exception as e:                     # noqa: BLE001
                    last_err = f"落盘失败：{e}"
                    continue
            else:
                # 这个源没补完，但已下的块仍然有效，换源接着补
                last_err = f"{url} 下载未完成"

        # ★ 全失败：只要下到过完整块就保留 .part + .blocks 供下次续传。
        #   一块都没下成（源全挂）才清理，避免留垃圾文件。
        if self._done_blocks:
            done_mb = self._progress_bytes(total if total else 0) / 1048576
            return False, (f"{last_err}。已下载约 {done_mb:.0f} MB 已保存，"
                           "下次点「一键安装」会从这里接着下，不用从头开始；"
                           "也可以点「改用 CPU 转写」直接用随软件自带的引擎。")
        self._cleanup(tmp)
        self._drop_blocks(tmp)
        return False, last_err or "全部下载源都失败了"

    def _try_one(self, url: str, tmp: Path, total: int, progress) -> bool:
        """对一个源做分块并发下载。支持「块级续传」。

        ★ 块级续传为什么必须有（2026-10-17 实测）：
          某一块反复失败时，老逻辑是整包换个源从头重下。439 MB 在慢镜像上
          要 5 分钟，换源重下等于把这 5 分钟白扔 —— 实际表现是文件时间戳
          一直在更新、永远下不完（用户看到的就是"卡在 98%"）。
          现在把下好的块记在 self._done_blocks 里，换源只补缺的那几块。
        """
        try:
            # 只有「本次下载已经下过块」才复用已有 .part；
            # 上次会话残留的 .part 内容不可信（不知道哪块是好的），一律重下。
            reuse = bool(self._done_blocks) and tmp.exists() and tmp.stat().st_size == total
            with open(tmp, "r+b" if reuse else "wb") as f:
                if not reuse:
                    self._done_blocks = set()
                    f.truncate(total)      # 预分配，省掉最后合并几 GB 的拷贝
                # 换源续传：进度接着上次的走，不能掉回 0（用户会以为前功尽弃）。
                # ★ 换源时把「进行中」的块作废：上一个源写到一半的字节不算数，
                #   只保留真正写完整的块。_peak 保证界面不往回跳。
                self._total = total
                self._inflight.clear()
                self._done = self._progress_bytes(total)
                self._peak = max(self._peak, self._done)
                ranges: list[tuple[int, int]] = []
                pos = 0
                while pos < total:
                    end = min(pos + self.BLOCK, total) - 1
                    ranges.append((pos, end))
                    pos = end + 1

                todo = [(i, s, e) for i, (s, e) in enumerate(ranges)
                        if i not in self._done_blocks]
                if not todo:
                    return True

                # 目标很小（比如 4 MB 的 CPU 包）就别开 8 个线程了，反而慢；
                # 服务端不支持 Range 时也只能老实单线程顺序下载。
                can_split = self._supports_range(url)
                n = (
                    self.threads
                    if can_split and total > 16 * 1024 * 1024 and len(todo) > 1
                    else 1
                )

                def whole():
                    """整包顺序下（没有 Range 支持，或 Range 被证明不可信时）。"""
                    f.seek(0)
                    f.truncate(0)
                    f.truncate(total)
                    # 退化成整包重下是真的从 0 开始：允许进度回落，但要说清楚，
                    # 别让客户以为「刚才 89% 白下了」却没有任何提示。
                    self._done_blocks = set()
                    self._inflight.clear()
                    self._peak = 0
                    self._done = 0
                    if progress:
                        progress(0, total)
                    if not self._fetch_range(url, 0, total - 1, f, 0, block_idx=-1):
                        return False
                    self._done_blocks = set(range(len(ranges)))
                    self._inflight.pop(-1, None)
                    self._done = total
                    if progress:
                        progress(total, total)
                    return True

                if n == 1:
                    if not can_split:
                        return whole()
                    for i, s, e in todo:
                        try:
                            if not self._fetch_range(url, s, e, f, s, block_idx=i):
                                return False
                        except _RangeIgnored:
                            return whole()
                        with self._lock:
                            self._done_blocks.add(i)
                            self._inflight.pop(i, None)
                            cur = max(self._peak, self._progress_bytes(total))
                        self._peak = cur
                        self._done = cur
                        if progress:
                            progress(cur, total)
                    if progress:
                        progress(total, total)
                    self._done = total
                    return True

                # 分多轮：每轮并发拉，失败的块留到下一轮。备用源常常慢好几倍，
                # 绝不能「一块失败就整个文件换源重下」。
                #
                # ★ 总时限：没有它的话，某个镜像对特定区间一直喂不全数据时，
                #   程序会在那里转 10 分钟以上（用户看到的是"卡在 99% 不动"）。
                #   到点就交回去换源，块级进度不丢，换源接着补。
                deadline = time.time() + 600
                pending: list[tuple[int, int, int]] = list(todo)
                for _round in range(4):
                    if not pending or self._cancel.is_set():
                        break
                    if time.time() > deadline:
                        break
                    failed: list[tuple[int, int, int]] = []
                    lock = threading.Lock()
                    range_bad = {"hit": False}

                    def worker():
                        while True:
                            with lock:
                                if not pending:
                                    return
                                i, s, e = pending.pop(0)
                            try:
                                got = self._fetch_range(url, s, e, f, s, block_idx=i)
                            except _RangeIgnored:
                                # 这个源不转发 Range：已经写进去的块全不可信
                                range_bad["hit"] = True
                                with self._lock:
                                    self._inflight.pop(i, None)
                                return
                            with self._lock:
                                # 无论成功失败，进行中的临时记账都要清掉：
                                # 成功 → 由 _done_blocks 计整块；失败 → 等下一轮重试
                                self._inflight.pop(i, None)
                                if got:
                                    self._done_blocks.add(i)
                            if not got:
                                with lock:
                                    failed.append((i, s, e))
                            if self._cancel.is_set():
                                return

                    ts = [threading.Thread(target=worker, daemon=True) for _ in range(n)]
                    for t in ts:
                        t.start()
                    # ★ v1.28.2：无条件跑 _pump。以前写成 `if progress:`，
                    #   没传进度回调的调用方就完全失去停滞检测与取消能力，
                    #   卡在 r.read() 里只能等 socket 超时（隐性契约，坑过人）。
                    self._pump(progress, total, ts)
                    # ★ v1.28.2：_pump 判定停滞/取消后，别再傻等卡在 r.read()
                    #   里的线程。以前 join(timeout*8) 最长干等 160 秒，客户点
                    #   「停止」后界面还会纹丝不动好几分钟。
                    #   线程是 daemon，且 _fetch_range 每次读到数据都会查 _cancel，
                    #   直接交回 download() 换源即可，不用等它们收尾。
                    if self._cancel.is_set() or self._stalled:
                        return False
                    for t in ts:
                        t.join(timeout=self.timeout * 8)
                    if any(t.is_alive() for t in ts):
                        return False
                    if range_bad["hit"]:
                        return whole()
                    if not failed:
                        if progress:
                            progress(total, total)
                        return True
                    pending = failed
                    if _round < 3:
                        time.sleep(1.0)      # 让镜像喘口气，下一轮更容易过
                return False
        except Exception:                                  # noqa: BLE001
            return False

    def _pump(self, progress, total: int, threads=None):
        """下载过程中定时上报进度（在调用线程里跑，避免开额外线程）。

        ★ v1.28.2 两条硬规矩：
          1. 上报值只增不减（_peak 单调保护），客户绝不会看到 90%→88%。
          2. 停滞检测只看「已完成块数」。以前看累计字节，某块反复被掐断
             时字节一会儿涨一会儿退，last_t 被无限刷新，60 秒保护形同虚设。
        """
        if self._stall_last_t <= 0:
            self._stall_last_t = time.time()
        while True:
            time.sleep(0.35)
            with self._lock:
                done = self._progress_bytes(total)
                nblocks = len(self._done_blocks)
            done = max(done, self._peak)
            self._peak = max(self._peak, done)
            self._done = done
            if progress:
                try:
                    progress(done, total)
                except Exception:                          # noqa: BLE001
                    return
            if self._cancel.is_set():
                return
            if done >= total:
                return
            if threads is not None and not any(t.is_alive() for t in threads):
                return     # 线程都退出了（多半是失败），别再空转

            # 停滞检测：连续 stall_timeout 秒**没有新的块完成**，判定源挂了。
            # 字节在同一块里反复重试不算进展 —— 这正是客户卡 89% 的成因。
            now = time.time()
            if nblocks != self._stall_last_blocks:
                self._stall_last_blocks = nblocks
                self._stall_last_t = now
            elif self.stall_timeout and (now - self._stall_last_t) > self.stall_timeout:
                self._stalled = True
                self._stall_count += 1
                self._cancel.set()
                return

    @staticmethod
    def _cleanup(p: Path):
        try:
            if p.exists():
                p.unlink()
        except Exception:                                  # noqa: BLE001
            pass

    # -- 跨会话块级续传 ---------------------------------------------
    @staticmethod
    def _blocks_file(tmp: Path) -> Path:
        return tmp.with_name(tmp.name + ".blocks")

    def _save_blocks(self, tmp: Path, total: int):
        """把已完成块号落盘，供下次启动接着下（只补缺的块）。

        ★ v1.28.2：以前下载失败一律 `_cleanup(tmp)` 删掉整个 .part，
          客户下了 392 MB 的 439 MB 包，点「停止」或换源失败后下次又从 0
          开始 —— 慢镜像下等于永远下不完。
        """
        if not self._done_blocks:
            return
        bf = self._blocks_file(tmp)
        try:
            payload = f"{total}\n" + ",".join(str(i) for i in sorted(self._done_blocks))
            staged = bf.with_suffix(bf.suffix + ".tmp")
            staged.write_text(payload, encoding="utf-8")
            staged.replace(bf)
        except Exception:                                  # noqa: BLE001
            pass

    def _load_blocks(self, tmp: Path, total: int) -> bool:
        """恢复上次没下完的进度。.part 体积对不上就一律不信。"""
        bf = self._blocks_file(tmp)
        try:
            if not bf.exists() or not tmp.exists():
                return False
            if tmp.stat().st_size != total:
                return False
            lines = bf.read_text(encoding="utf-8").strip().splitlines()
            if len(lines) < 2 or int(lines[0]) != total:
                return False
            blocks = {int(x) for x in lines[1].split(",") if x.strip().isdigit()}
            nblocks = (total + self.BLOCK - 1) // self.BLOCK
            blocks = {i for i in blocks if 0 <= i < nblocks}
            if not blocks:
                return False
            self._done_blocks = blocks
            return True
        except Exception:                                  # noqa: BLE001
            return False

    def _drop_blocks(self, tmp: Path):
        try:
            bf = self._blocks_file(tmp)
            if bf.exists():
                bf.unlink()
        except Exception:                                  # noqa: BLE001
            pass


def _urls_for(base_list: list[str], name: str) -> list[str]:
    return [b.rstrip("/") + "/" + name for b in base_list]


