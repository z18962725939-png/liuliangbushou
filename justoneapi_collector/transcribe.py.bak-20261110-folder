def _progress_wrapper(progress, log, slow_after: float = 25.0):
    """包一层进度回调：长时间没动静时主动说句话。

    下载几百 MB 的模型时，进度条几秒不动用户就会以为程序死了。
    与其让他去猜，不如明确告诉他"还在下载，只是慢"。
    """
    state = {"pct": -1, "t": time.time(), "warned": False,
             "t0": time.time(), "reported": 0.0,
             "last_done": 0, "last_t": time.time()}

    def wrapped(done, total):
        # ★ 进度只增不减：下载器内部换源/重试时算出短暂回落，也不该让
        #   客户看到 90%→88%（v1.28.2 客户截图里的原症状）。
        done = max(0, min(int(done), int(total) if total else int(done)))
        pct = int(done * 100 / total) if total else 0
        now = time.time()
        if pct != state["pct"]:
            state["pct"] = pct
            state["t"] = now
        elif not state["warned"] and (now - state["t"]) > slow_after:
            state["warned"] = True
            if log:
                log("下载比较慢，可以不用等：点「停止」，把「设备」切到「CPU 转录」"
                    "就能直接开始转写（引擎随软件自带、不联网，结果一样只是慢一些）。"
                    "想继续用显卡，也可以用迅雷/Motrix 下好包再点「导入本地引擎包」。")

        # 每 20 秒报一次速度和预计剩余时间。
        # ★ v1.28.2：老实现用「累计下载量 / 从零开始的总耗时」算平均速度，
        #   分母一直涨、分子一震荡，于是出现 1.5→1.0→1.2→0.8 分钟反复横跳。
        #   改成最近一个采样窗口的实测速度，数字才可信。
        if log and done > 0 and (now - state["reported"]) > 20:
            span = max(0.1, now - state["last_t"])
            speed = max(0.0, (done - state["last_done"]) / span)
            left = (total - done) / speed if speed > 0 else 0
            state["reported"] = now
            state["last_done"] = done
            state["last_t"] = now
            if speed > 0:
                log(
                    f"已下载 {pct}%（{done / 1048576:.0f}/{total / 1048576:.0f} MB），"
                    f"当前约 {speed / 1024:.0f} KB/s，按此速度还需 {left / 60:.1f} 分钟"
                )
            else:
                log(f"已下载 {pct}%（{done / 1048576:.0f}/{total / 1048576:.0f} MB），"
                    "这一段暂时没有新增数据，程序会自动换源重试")
        if progress:
            progress(done, total)

    return wrapped


def _clear_engine_dir(kind: str) -> None:
    """装新引擎前把旧目录清掉。

    为什么必须清：11.8 包和 12.4 包的文件**同名不同版本**（ggml-cuda.dll、
    whisper.dll 都叫同一个名字）。直接覆盖解压会让新旧混在一起，
    出现"改了没生效"或新的 cublas 配旧的后端这种更难看的问题。
    只清引擎目录，不动模型（1.5 GB 的模型不用重下）。
    """
    d = engine_dir(kind)
    try:
        if d.exists():
            shutil.rmtree(str(d), ignore_errors=True)
    except Exception:                                      # noqa: BLE001
        pass


def install_engine(kind: str, progress=None, log=None,
                   on_downloader=None) -> tuple[bool, str]:
    """下载并解压 whisper.cpp 引擎。已就绪则直接返回 True。

    progress(done, total)；log(text) 用于给界面刷文字。
    on_downloader(dl) 可选：把下载器交给界面，让「停止」能真正取消下载。
    ★ v1.28.2：以前下载 439 MB 时界面没有任何出口，客户只能对着 89%
      干等甚至强杀进程 —— 现在必须能把 downloader 交出去。
    """
    if engine_ready(kind):
        return True, "引擎已就绪，无需重复安装"

    asset = CPU_ASSET
    if kind == "cuda":
        gpu = detect_gpu()
        key, why = pick_cuda_bundle(gpu)
        if not key:
            # 驱动太旧：不能装作"下载失败"，要把人话原因带回去
            if log:
                log(why)
            return False, why
        asset = CUDA_BUNDLES[key]["asset"]
        if log:
            log(why)

    d = engine_dir(kind)
    # 旧目录可能是半个包、或上一版不带 cuBLAS 的 11.8，先清再解压
    if d.exists() and not engine_ready(kind):
        if log:
            log("清理旧的引擎文件…")
        _clear_engine_dir(kind)
    d.mkdir(parents=True, exist_ok=True)
    zip_path = whisper_home() / (asset or "engine.zip")

    if log:
        log(f"开始下载引擎包：{asset}")
    dl = Downloader()
    if on_downloader:
        try:
            on_downloader(dl)
        except Exception:                                  # noqa: BLE001
            pass
    ok, err = dl.download(
        _urls_for(ENGINE_MIRRORS, asset), zip_path,
        progress=_progress_wrapper(progress, log),
        expect_sha256=ASSET_SHA256.get(asset, ""),
    )
    if not ok:
        if log:
            if dl.cancelled:
                log("已停止下载。这个显卡引擎只影响速度，不影响能不能转写："
                    "把「设备」切到「CPU 转录」即可直接开始，随包自带、不用联网。")
            else:
                log(f"下载失败：{err}")
        if dl.cancelled:
            return False, "已停止下载显卡引擎。可切到「CPU 转录」直接使用，无需等待下载。"
        return False, f"引擎下载失败：{err}"

    if log:
        log("下载完成，正在解压…")
    try:
        with zipfile.ZipFile(zip_path) as z:
            z.extractall(d)
    except Exception as e:                                 # noqa: BLE001
        return False, f"解压失败：{e}"
    finally:
        try:
            if zip_path.exists():
                zip_path.unlink()
        except Exception:                                  # noqa: BLE001
            pass

    exe = engine_exe(kind)
    if not exe:
        return False, "解压后没找到 whisper-cli.exe，引擎包可能不完整"
    # ★ 解压完必须复验：包齐全 ≠ 能跑，缺 cublas 时 exe 也在，但一启动就弹系统框
    problem = engine_problem(kind)
    if problem:
        return False, problem
    if log:
        log(f"引擎安装完成并已校验可用：{exe}")
    return True, str(exe)


def install_model(key: str, progress=None, log=None) -> tuple[bool, str]:
    """下载 ggml 模型。已就绪则直接返回 True。"""
    info = MODELS.get(key)
    if not info:
        return False, f"未知模型：{key}"
    dest = models_dir() / info["file"]
    if model_ready(key):
        return True, str(dest)

    if log:
        log(f"开始下载模型：{info['file']}（约 {info['size_mb']} MB）")
    dl = Downloader()
    ok, err = dl.download(
        _urls_for(MODEL_MIRRORS, info["file"]), dest,
        total_hint=info["size_mb"] * 1024 * 1024,
        progress=_progress_wrapper(progress, log),
    )
    if not ok:
        if log:
            log(f"模型下载失败：{err}")
        return False, f"模型下载失败：{err}"
    # 模型没有官方哈希可对，只能复核体积；坏包在转写时会输出乱码，
    # 与其让客户对着一堆乱码猜，不如在这里拦下来重下。
    if not model_ready(key):
        return False, (f"模型文件不完整（{dest.name} 体积只有 "
                       f"{dest.stat().st_size / 1048576:.0f} MB，"
                       f"应为约 {info['size_mb']} MB），请重新下载")
    if log:
        log(f"模型就绪：{dest}")
    return True, str(dest)


def _bundle_root() -> Path:
    """打包运行时的资源根目录（PyInstaller 会把资源解压到 _MEIPASS）。"""
    try:
        return Path(sys._MEIPASS)                          # noqa: SLF001
    except Exception:                                      # noqa: BLE001
        return Path(__file__).resolve().parent


def bundled_cpu_engine() -> Path | None:
    """安装包里自带的 CPU 引擎目录；没有就返回 None。"""
    cands = [
        _bundle_root() / "whisper_cpu",
        Path(__file__).resolve().parent.parent / "assets" / "whisper_cpu",
    ]
    for c in cands:
        try:
            if (c / "Release" / "whisper-cli.exe").exists() or (c / "Release" / "main.exe").exists():
                return c
        except Exception:                                  # noqa: BLE001
            continue
    return None


def bootstrap_engine(kind: str = "cpu") -> bool:
    """首次运行时把随包自带的 CPU 引擎释放到用户目录 —— 不联网也能转写。

    只内置 CPU 引擎：它只有约 2 MB，而 CUDA 引擎动辄几十上百 MB，
    塞进安装包不划算，那个仍然按用户显卡按需下载。
    """
    if kind != "cpu":
        return False
    if engine_ready("cpu"):
        return True
    src = bundled_cpu_engine()
    if src is None:
        return False
    try:
        dst = engine_dir("cpu")
        dst.mkdir(parents=True, exist_ok=True)
        for f in src.rglob("*"):
            if f.is_file():
                target = dst / f.relative_to(src)
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(str(f), str(target))
    except Exception:                                      # noqa: BLE001
        return False
    return engine_ready("cpu")


def import_engine_zip(zip_path: Path, kind: str) -> tuple[bool, str]:
    """从本地 zip 导入引擎。

    给网络不好（或公司网络屏蔽 GitHub）的用户留的口子：
    他可以用迅雷 / Motrix 之类下载工具先把包下下来，再从这里导入，
    不用在程序里干等一条慢速链路。

    ★ v1.14.6：导入同样要复验。用户很容易下到 11.8 那个 59 MB 的小包
      （搜索"whisper cublas 下载"第一个往往就是它），导进去照样跑不起来。
      这里直接告诉他"这个包不含 cuBLAS，请改用 12.4 那个 439 MB 的"。
    """
    try:
        d = engine_dir(kind)
        if d.exists():
            _clear_engine_dir(kind)
        d.mkdir(parents=True, exist_ok=True)
        with zipfile.ZipFile(zip_path) as z:
            z.extractall(d)
    except Exception as e:                                 # noqa: BLE001
        return False, f"解压失败：{e}"
    exe = engine_exe(kind)
    if not exe:
        return False, "压缩包里没找到 whisper-cli.exe，确认下载的是 Windows x64 包"
    problem = engine_problem(kind)
    if problem:
        return False, problem
    return True, str(exe)


def import_model_file(src: Path, key: str) -> tuple[bool, str]:
    """导入本地已下载好的 ggml 模型文件。"""
    info = MODELS.get(key)
    if not info:
        return False, f"未知模型：{key}"
    dest = models_dir() / info["file"]
    try:
        models_dir().mkdir(parents=True, exist_ok=True)
        if Path(src).resolve() != dest.resolve():
            shutil.copy2(str(src), str(dest))
    except Exception as e:                                 # noqa: BLE001
        return False, f"复制失败：{e}"
    if not model_ready(key):
        return False, (
            f"导入后体积校验未通过（{human_size(dest.stat().st_size)}，"
            f"期望约 {info['size_mb']} MB），文件可能不完整"
        )
    return True, str(dest)


