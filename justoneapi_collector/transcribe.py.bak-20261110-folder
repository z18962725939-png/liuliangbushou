@dataclass
class GpuInfo:
    """一张 NVIDIA 显卡的信息。"""
    name: str = ""
    driver: str = ""
    cuda: str = ""            # 驱动支持的 CUDA 运行时版本，形如 '13.4'
    mem_mb: int = 0
    found: bool = False
    reason: str = ""          # 没找到时的原因（给用户看）

    @property
    def mem_gb(self) -> float:
        return round(self.mem_mb / 1024, 1) if self.mem_mb else 0.0

    def cuda_tuple(self) -> tuple[int, ...]:
        """把 '13.4' 变成 (13, 4)，便于比较大小；解析不了返回 (0,)。"""
        try:
            return tuple(int(x) for x in self.cuda.split(".") if x.isdigit()) or (0,)
        except Exception:                                  # noqa: BLE001
            return (0,)

    def summary(self) -> str:
        if not self.found:
            return self.reason or "未检测到 NVIDIA 显卡"
        return f"{self.name}｜驱动 {self.driver}｜显存 {self.mem_gb} GB｜支持 CUDA {self.cuda or '未知'}"


def nvidia_smi_path() -> str | None:
    """找到 nvidia-smi，找不到返回 None。"""
    p = shutil.which("nvidia-smi")
    if p:
        return p
    exe = "nvidia-smi.exe" if os.name == "nt" else "nvidia-smi"
    for cand in (
        Path(r"C:\Windows\System32") / exe,
        Path(r"C:\Program Files\NVIDIA Corporation\NVSMI") / exe,
        Path(os.environ.get("SystemRoot", r"C:\Windows")) / "System32" / exe,
    ):
        try:
            if cand.exists():
                return str(cand)
        except Exception:                                  # noqa: BLE001
            continue
    return None


def _run(cmd: list[str], timeout: float = 15.0) -> tuple[int, str]:
    """跑一条命令并返回 (返回码, 输出)。任何异常都吞掉，UI 不该因此崩。"""
    try:
        proc = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout,
            encoding="utf-8", errors="replace",
            creationflags=subprocess.CREATE_NO_WINDOW if os.name == "nt" else 0,
        )
        return proc.returncode, (proc.stdout or "") + (proc.stderr or "")
    except FileNotFoundError:
        return 127, ""
    except subprocess.TimeoutExpired:
        return 124, ""
    except Exception:                                      # noqa: BLE001
        return 1, ""


def detect_gpu() -> GpuInfo:
    """检测本机 NVIDIA 显卡。检测不到时返回 found=False 的 GpuInfo。"""
    smi = nvidia_smi_path()
    if not smi:
        return GpuInfo(reason="没找到 nvidia-smi，可能不是 N 卡或没装驱动")

    # 1) 显卡名 / 驱动 / 显存
    rc, out = _run([
        smi, "--query-gpu=name,driver_version,memory.total", "--format=csv,noheader",
    ])
    if rc != 0 or not out.strip():
        return GpuInfo(reason="nvidia-smi 执行失败，显卡驱动可能未正确安装")

    line = out.strip().splitlines()[0]
    parts = [x.strip() for x in line.split(",")]
    name = parts[0] if parts else ""
    driver = parts[1] if len(parts) > 1 else ""
    mem_mb = 0
    if len(parts) > 2:
        m = re.search(r"(\d+)", parts[2].replace(" ", ""))
        if m:
            mem_mb = int(m.group(1))

    # 2) CUDA 版本：新版驱动输出 'CUDA UMD Version: 13.4'，老版是 'CUDA Version: 12.4'
    _, head = _run([smi])
    cuda = ""
    m = re.search(r"CUDA\s+(?:UMD\s+)?Version:\s*([\d.]+)", head)
    if m:
        cuda = m.group(1)

    return GpuInfo(name=name, driver=driver, cuda=cuda, mem_mb=mem_mb, found=True)


def pick_cuda_bundle(gpu: GpuInfo) -> tuple[str, str]:
    """按显卡挑 CUDA 包，返回 (档位key, 说明)。空 key 表示「这台机器上显卡跑不了」。

    规则（v1.14.6 重写）：
      唯一默认是 12.4 自包含包。理由不是"新"，而是**只有它自带 cuBLAS**：
      11.8 包虽然有 59 MB 的便宜，但它把 cuBLAS 甩给用户的 CUDA Toolkit 去提供，
      而装 Toolkit 要 3 GB 且普通客户根本不会 —— 实测就是这么炸的
      （「找不到 cublas64_11.dll」）。宁可第一次多下 380 MB，也不要装完不能用。
    """
    need = (12, 0)
    if gpu.cuda_tuple() < need:
        cur = gpu.cuda or "未知"
        return "", (
            f"显卡驱动支持的最高 CUDA 是 {cur}，低于 12.4。\n"
            f"有两个办法：① 更新 NVIDIA 显卡驱动（推荐，几分钟，更新后可用显卡转写）；"
            f"② 直接用 CPU 转录（任何电脑都能跑，只是慢一些）。"
        )
    return (
        DEFAULT_CUDA_BUNDLE,
        f"检测到 {gpu.name}，使用 CUDA 12.4 包（439 MB，自带运行库，不需要另外安装 CUDA Toolkit）",
    )


def recommend_model(device: str, gpu: GpuInfo | None) -> str:
    """按设备条件推荐一个模型 key。"""
    if device == "cuda" and gpu and gpu.found:
        g = gpu.mem_gb
        if g >= 8:
            return "large-v3-turbo"
        if g >= 5:
            return "medium"
        if g >= 2:
            return "small"
        return "base"
    return "small" if device == "cuda" else "base"


